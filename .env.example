# MySQL Database Configuration
# Format: mysql://username:password@host:port/database
# Local example: mysql://root:password@localhost:3306/herdlist
DATABASE_URL=mysql://username:password@localhost:3306/herdlist

# Session Secret (generate a random string for production)
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-random-secret-key-here

# Node Environment
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# Server Host (default: 0.0.0.0; use 127.0.0.1 for local-only access)
HOST=0.0.0.0

# Timesheets authentication (required for Herd List login and bearer API access)
TIMESHEETS_API_URL=https://timesheets.deckfamilyfarm.com/api
# Optional comma-separated Timesheets roles. Empty allows every valid role.
HERDLIST_TIMESHEETS_ALLOWED_ROLES=
# Origins allowed to exchange a Timesheets browser launch token for a session.
TIMESHEETS_LAUNCH_ALLOWED_ORIGINS=https://timesheets.deckfamilyfarm.com

# Production Database Examples:
# Standard MySQL: mysql://user:pass@your-mysql-server.com:3306/herdlist
# With SSL: mysql://user:pass@your-mysql-server.com:3306/herdlist?ssl={"rejectUnauthorized":true}
# AWS RDS: mysql://admin:password@herdlist.xxxxx.us-east-1.rds.amazonaws.com:3306/herdlist
